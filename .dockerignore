**/*[sS][eE][cC][rR][eE][tT]*.[pP][eE][mM]

# Operational repository/package roots, not lib/src/include/test/tests/assets/docs
# runtime/cache namespaces. Custom private stores need explicit exclusions too.
/runtime
/cache
/caches
/examples/*/runtime
/examples/*/cache
/examples/*/caches
/vendor/*/runtime
/vendor/*/cache
/vendor/*/caches
