{
  "package": "jido",
  "source": "https://github.com/agentjido/jido",
  "ref": "8322de574c53d5c2096243d230c9de4f14803bda",
  "branch_at_import": "release/v3",
  "upstream_version": "3.0.0-beta.1",
  "license": "Apache-2.0",
  "purpose": "Immutable native V3 Core source explicitly pinned by JidoAI1f19ff26; not stock V2 or a compatibility loop.",
  "discovered_incompatible_tip": {
    "ref": "2ce0e40e18cc1ecc64882aaf492de6f06bb5fd73",
    "upstream_version": "3.0.0-beta.2",
    "reason": "Changes Agent provider/route/authoring and Action/Exec/Flow contracts beyond the native V3 revision supported by AI1f19ff26. Selected AI source pins8322de57 explicitly."
  },
  "inventory_note": "files describe original upstream source bytes before explicit local boundary_patches.",
  "boundary_patches": [
    {
      "id": "oh_my_jido_native_v3_private_diagnostics_v1",
      "date": "2026-10-19",
      "contributors": "Oh-My-Jido contributors",
      "license": "Apache-2.0",
      "purpose": "Opt-in metadata-only diagnostics for native V3 gen_statem Agents; preserve native Signal, Action/Flow, commit, failure-policy and supervision behavior without a V2 compatibility runtime.",
      "opt_in": "Agent module exports private_diagnostics?/0 returning true, or privacy is inherited through native parent metadata. Inherited privacy remains enabled after parent loss.",
      "contract": "Jido.AgentServer.private_diagnostics_version/0 returns 1. Native Jido Exec receives private_diagnostics: %{private?: true, error: unary_projector}; successful results are unchanged. Failures retain native class and bounded machine-readable code/status/retryability; finite atom/integer-only control terms remain intact. Messages, arbitrary detail values, stack arguments and source locations are not diagnostics.",
      "modified_upstream_files": [
        {"path": "lib/jido/agent_server.ex", "change": "Wrap native OTP callbacks, export private diagnostic version/format_status, document the opt-in contract, and hide private supervisor startup MFA arguments in opaque function environments."},
        {"path": "lib/jido/agent/runner.ex", "change": "Pass the explicit native Exec privacy policy for private direct commands and bound their failed results without altering successful candidate state or directives."},
        {"path": "lib/jido/agent_server/child_lifecycle.ex", "change": "Retain inherited privacy during native adoption and after parent loss."},
        {"path": "lib/jido/agent_server/child_operations.ex", "change": "Propagate private diagnostic opt-in through native child creation and adoption metadata."},
        {"path": "lib/jido/agent_server/plugin_child.ex", "change": "Protect private Plugin lifecycle OTP status, callback failures and readiness Tasks."},
        {"path": "lib/jido/agent_server/plugin_lifecycle.ex", "change": "Carry the authoritative private flag to native Plugin lifecycle workers and hide initial/replacement child startup arguments from supervisor reports."},
        {"path": "lib/jido/agent_server/post_commit.ex", "change": "Project private directive and commit-notification failures before logging and failure policy."},
        {"path": "lib/jido/agent_server/server_lifecycle.ex", "change": "Initialize inherited privacy and contain native readiness worker failures."},
        {"path": "lib/jido/agent_server/state.ex", "change": "Store one sticky inherited-private boolean in native runtime state."},
        {"path": "lib/jido/agent_server/storage.ex", "change": "Project private shutdown-persistence log errors without changing write behavior."},
        {"path": "lib/jido/agent_server/task_support.ex", "change": "Contain private native lifecycle Task failures before OTP crash diagnostics and return propagation."},
        {"path": "lib/jido/agent_server/turn.ex", "change": "Pass the explicit native Exec policy and keep private unconstrained tracestate/causation out of exported telemetry while preserving execution Signal trace propagation."},
        {"path": "lib/jido/agent_server/turn_completion.ex", "change": "Project private pre-commit errors before logs, policy and replies, retaining required persistence-failure stop tags."},
        {"path": "lib/jido/telemetry/agent.ex", "change": "Omit caller-controlled private trace baggage from native lifecycle, turn and admission metadata; reuse upstream semantic payload bounding."}
      ],
      "local_additions": [
        {"path": "lib/jido/agent_server/private_diagnostics.ex", "change": "Native V3 opt-in detection, scoped callback/Task failure handling, OTP status projection, bounded error projection, opaque supervisor startup specifications and request-scoped Exec policy. Preserve the original explicit or implicit OTP modules metadata when hiding startup arguments, so Agent actors and Plugin lifecycle workers retain their actual module identities. Reject nested opaque exception structs before finite-map traversal so diagnostic projection cannot manufacture callback/task failures; retain native agent-error and max-error stop-policy tags around bounded failures."}
      ],
      "required_dependency_boundary": "The licensed native jido_action19c77f94 snapshot carries the explicit request-scoped Exec/Controller/Worker/telemetry projector. Core cannot redact an error after another dependency has already emitted it.",
      "limits": "Protection applies to work admitted after private activation; already-admitted public work cannot be retroactively privatized by later adoption. Required Oh-My-Jido paths opt in from birth or adopt before admitting work. Privacy is an activation policy: a new activation of an otherwise-public module must inherit or declare the opt-in again. This is a diagnostic boundary, not a BEAM sandbox or encryption layer. Privileged sys.get_state/process inspection, deliberately enabled raw OTP sys debug buffers, function environment extraction and application-authored logging remain trusted-host operations. Native Agent/snapshot APIs intentionally return authorized full state.",
      "verification": "Not run by this migration worker; all build, test, lint, format and smoke checks are deferred to the integration owner."
    }
  ],
