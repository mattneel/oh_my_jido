    "contents_tar_gz_sha256": "8cd0f379f1cb8b930a42261a90871f0e79cc732cfd29d86ee3d180eca3ebbec8"
  },
  "snapshot_contents": "All 245 regular files from the pristine published Hex contents.tar.gz, plus its unmodified outer metadata.config copied as hex_metadata.config. No package members are omitted. Installed-only .hex, Python bytecode/caches, and priv/data are not source package members and are not included.",
  "snapshot_sha256": "aaa434dfb28d83f97b84606d9f0632a4a963fc42a11cdbe20f88227be82c0bf0",
  "snapshot_digest_algorithm": "SHA-256 over UTF-8 lines <lowercase per-file SHA-256><two spaces><relative POSIX path><LF>, sorted lexicographically by path; files contains the complete pristine inventory, including hex_metadata.config.",
  "patched_snapshot_sha256": "f7cf833ff819d3159679e509f34e14706546395280af8ba9eade3ae9dfd12a14",
  "patched_digest_algorithm": "Same line algorithm over the pristine inventory with modified-file digests replaced and local additions included; UPSTREAM.json itself is excluded to avoid a self-reference.",
  "privacy_boundary_updates": {
    "date": "2026-10-17",
    "contributors": "Oh-My-Jido contributors",
    "marker": "Snakepit.GRPCWorker.private_diagnostics_version/0 returns 1",
    "opt_in": "Trusted native worker_config %{private_diagnostics: true}; request arguments, streaming options, and ambient application logging configuration cannot opt in or out.",
    "trusted_vm_boundary": "Supported SDK requests and asynchronous completions use opaque native envelopes, and private callback states remain opaque in OTP sys-debug history. Arbitrary direct raw BEAM/GenServer messages from trusted VM code can be recorded by OTP before callbacks run; initializer-environment introspection is trusted VM access, not credential isolation.",
    "modified_upstream_files": [
      {
        "path": "lib/snakepit/grpc/client_impl.ex",
        "change": "Formats private worker RPC error logs as type/count metadata instead of remote error text; native RPC status mapping and nonprivate logging remain unchanged.",
        "pristine_sha256": "d988c3cb3f3a11714077b5ea6f1a84aa37325a9798594b44ff815c308f42429b",
        "patched_sha256": "e7c497c68ea6592b5b46e851810b423d7eb5dc2e0796d3fcd2a7dfd0ac32a5bf",
        "patched_bytes": 13926
      },
      {
        "path": "lib/snakepit/grpc_worker.ex",
        "change": "Adds the trusted private_diagnostics marker, metadata-only OTP status/crash diagnostics, guarded native callbacks, and opaque private SDK request/completion and callback-state initializers so raw sys-debug history does not retain inspectable private configuration or RPC values. Default workers retain native diagnostic payloads and lifecycle; the explicit nonprivate cast default matches Elixir without deprecated super.",
        "pristine_sha256": "a48f42e96d0486c5146d868e9a1b25c80f14be1b51f5535674fd057385aa4303",
        "patched_sha256": "66afa1aa040f21cdf771a7c778e4a3bdf2520e29e6d4e51ee84fb07b0de32393",
        "patched_bytes": 47816
      },
      {
        "path": "lib/snakepit/grpc_worker/bootstrap.ex",
        "change": "Routes private native startup failure diagnostics through the worker-local metadata formatter without changing startup prerequisites, handshakes, or process ownership.",
        "pristine_sha256": "b09749f8f76dfe329dcc192624faf2dd5b3d4f3efe745dbb635c62f7c70be111",
        "patched_sha256": "08c7e81e37df881c0f4152013f6de01edd2cb2e72763bfbbada3b331f8456c0c",
        "patched_bytes": 15291
      },
      {
        "path": "lib/snakepit/grpc_worker/instrumentation.ex",
        "change": "Uses generated diagnostic correlation and native session identity for private spans, excluding request-derived values and normalizing exceptions/errors inside the telemetry boundary; default instrumentation is unchanged.",
        "pristine_sha256": "7c7525561b92c402d88e4417339272d996ea719c27c1ff47492b4fd349e8bae6",
        "patched_sha256": "1a4e77550b0522cc61f5f01ff220f758d1f42c5dafaa925cd9b71502a48021cd",
        "patched_bytes": 6974
      },
      {
        "path": "lib/snakepit/pool/worker_starter.ex",
        "change": "Retains exact private native worker restart/init arguments in opaque anonymous initializers so OTP supervisor offender MFAs cannot print worker configuration or environment; restart policies and native supervision remain unchanged.",
        "pristine_sha256": "baebd6fed572ec77deacbb87134bbeaafb9e69c4dbb39a143fb7c3d7ad0eaa5a",
        "patched_sha256": "b9eab83c6554ee33c0f6d3f8a23488696304b909359f914427d1fa6bd257ec6b",
        "patched_bytes": 8398
      },
      {
        "path": "lib/snakepit/worker/configuration.ex",
        "change": "Logs private launch identity and argument/environment counts instead of private executable argument values; spawn configuration and nonprivate diagnostics remain unchanged.",
        "pristine_sha256": "4581bace2bef5f6297696c74f4b519797d49678caa0a4bb5964714796e05deba",
        "patched_sha256": "bb4acb9f1a2f0e240e22daa34c22cb58faf300040b3ed147d4a4ea58de01945a",
        "patched_bytes": 9462
      },
      {
        "path": "lib/snakepit/worker/process_manager.ex",
        "change": "Keeps private Python startup output and cleanup reasons metadata-only without changing native port spawning, readiness, termination, or process cleanup.",
        "pristine_sha256": "b6df3fff638cd1d3cd3e0d53857736d02600afa0a9c2a0c1ec4f6e5037002519",
        "patched_sha256": "63ab20416e7e68bd9118519080d73bd35d92eb0c86bac649930b4029ed19504a",
        "patched_bytes": 10617
      }
    ],
    "modified_local_additions": [
      {
        "path": "lib/snakepit/grpc_worker/private_diagnostics.ex",
        "change": "Native GRPCWorker-only trusted opt-in diagnostic formatting, opaque state/request/completion representation, callback-result validation, and RPC failure normalization; no process, transport, credential service, or global Logger filter.",
        "sha256": "78c360f8a2d25f2a7c6f3b2df7b255145ff0f300a85602ab3419aa8344f6fa01",
        "bytes": 10810
      }
    ],
    "inventory_note": "files and snapshot_sha256 retain the original pristine upstream bytes and source digest, not modified runtime hashes. Every modified upstream file and local addition carries a dated MIT/provenance notice. The original MIT LICENSE is unchanged."
