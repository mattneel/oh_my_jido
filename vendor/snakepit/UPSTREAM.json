  "purpose": "Narrow opt-in native private diagnostics for exclusively leased Python Eval workers; no replacement process manager or transport",
  "source_archive": {
    "url": "https://repo.hex.pm/tarballs/snakepit-0.14.0.tar",
    "sha256": "4f9e37ca5f6442e75a8bbdbb4112f46583a91d8509759cd4117d024583a75bf2",
