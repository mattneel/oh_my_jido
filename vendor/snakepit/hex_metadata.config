{<<"name">>,<<"snakepit">>}.
{<<"version">>,<<"0.14.0">>}.
{<<"description">>,
 <<"High-performance pooler and session manager for external language integrations.\nSupports Python, Node.js, Ruby, and more with gRPC streaming, session management,\nand production-ready process cleanup.">>}.
{<<"elixir">>,<<"~> 1.18">>}.
{<<"app">>,<<"snakepit">>}.
