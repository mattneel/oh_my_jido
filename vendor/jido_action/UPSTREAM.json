{
  "package": "jido_action",
  "source": "https://github.com/agentjido/jido_action",
  "ref": "19c77f94e5c2513b2e684a289857fcd568f7eb29",
  "upstream_version": "3.0.0-beta.12",
  "license": "Apache-2.0",
  "purpose": "Native V3 Action and Exec source explicitly pinned by native JidoAI1f19ff26; minimal private diagnostics and execution-group lifecycle boundaries.",
  "inventory_note": "files describe original upstream source bytes before explicit local boundary_patches.",
  "boundary_patches": [
    {
      "date": "2026-10-19",
      "contributors": "Oh-My-Jido contributors",
      "purpose": "Explicit opt-in private diagnostics on the unchanged native V3 execution path.",
      "modified_upstream_files": [
        "lib/jido_exec.ex",
        "lib/jido_exec/options.ex",
        "lib/jido_exec/controller.ex",
        "lib/jido_exec/worker.ex",
        "lib/jido_exec/telemetry.ex"
      ],
      "added_files": [
        "lib/jido_exec/private_diagnostics.ex"
      ],
      "change": "Inherits a caller-owned diagnostic projector before native control/worker callbacks and telemetry; private Tasks hide process introspection and report escaping failures with projected diagnostics and argument-free frames. Action results, native execution ownership, ordinary callers, and zero-retry behavior remain unchanged."
    },
    {
      "date": "2026-10-19",
      "contributors": "Oh-My-Jido contributors",
      "purpose": "Opt-in native execution-group admission and synchronous worker-shutdown receipts for truthful consumer stop.",
      "modified_upstream_files": [
        "lib/jido_exec.ex",
        "lib/jido_exec/options.ex",
        "lib/jido_exec/controller.ex",
        "lib/jido_exec/worker.ex"
      ],
      "added_files": [
        "lib/jido_exec/lifecycle_observer.ex"
      ],
      "change": "Calls the trusted observer from the actual existing control after its private Task.Supervisor exists and before user dispatch; inherits the accepted opaque token as the sticky parent scope in native controls and workers. Halted admissions shut down without user work. Stopped callbacks receive the original identity proof plus workers_stopped: true only after synchronous supervisor/link shutdown barriers completed; failed or skipped cleanup and forced control death provide no affirmative receipt. Callback failures and invalid returns remain contained without callback values in Task errors. Existing native process trees, owner/deadline semantics, results, and ordinary unobserved execution remain unchanged."
    }
  ],
